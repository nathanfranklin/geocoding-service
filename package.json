{
  "name": "geocoding-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-endpoint forward + reverse geocoding API over OpenStreetMap",
  "scripts": {
    "dev": "tsx watch --env-file=dev.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=dev.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.0",
    "fastify": "^5.3.0",
    "pg": "^8.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
